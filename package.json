{
  "name": "yl-hb-tmdb",
  "version": "1.0.0",
  "description": "TMDb enrichment pipeline for social and media profiles",
  "main": "dist/tmdb-social-enrichment.js",
  "scripts": {
    "build": "tsc",
    "social": "tsx src/tmdb-social-enrichment.ts",
    "media": "tsx src/tmdb-media-enrichment.ts",
    "dev:social": "LIMIT=5 tsx src/tmdb-social-enrichment.ts",
    "dev:media": "LIMIT=5 tsx src/tmdb-media-enrichment.ts",
    "trending": "tsx src/tmdb-trending-mining.ts",
    "dev:trending": "MAX_PAGES=1 tsx src/tmdb-trending-mining.ts",
    "popular": "tsx src/tmdb-popular-mining.ts",
    "dev:popular": "MAX_PAGES=1 tsx src/tmdb-popular-mining.ts"
  },
  "keywords": [
    "tmdb",
    "enrichment",
    "supabase"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/node-fetch": "^2.6.11",
    "typescript": "^5.3.3",
    "tsx": "^4.19.0"
  }
}
